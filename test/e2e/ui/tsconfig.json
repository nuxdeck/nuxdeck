{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "lib": [
      "ES2022",
      "DOM"
    ],
    "typeRoots": [
      "../../../web/node_modules/@types"
    ],
    "types": [
      "node"
    ]
  },
  "include": [
    "playwright.config.ts",
    "specs/**/*.ts",
    "helpers/**/*.ts"
  ]
}
