{
  "name": "nuxdeck-e2e-ui",
  "private": true,
  "version": "0.0.0",
  "description": "Browser end-to-end and accessibility tests for the Nux Deck web UI (Apache-2.0)",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.18.0",
  "scripts": {
    "test": "playwright test",
    "typecheck": "../../../web/node_modules/.bin/tsc --noEmit -p tsconfig.json",
    "lint": "../../../web/node_modules/.bin/eslint . && ../../../web/node_modules/.bin/prettier --check .",
    "format": "../../../web/node_modules/.bin/prettier --write ."
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.0"
  }
}
