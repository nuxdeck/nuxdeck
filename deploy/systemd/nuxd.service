[Unit]
Description=Nux Deck server
Documentation=https://github.com/nuxdeck/nuxdeck
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=nuxd
Group=nuxd
ExecStart=/usr/local/bin/nuxd
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s

# /var/lib/nuxd (data, database, TLS key) and /etc/nuxd (optional nuxd.yaml) are created and owned by systemd.
StateDirectory=nuxd
StateDirectoryMode=0700
ConfigurationDirectory=nuxd
ConfigurationDirectoryMode=0750
UMask=0077

# Sandbox: nuxd only needs its own state directory and the network.
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources

[Install]
WantedBy=multi-user.target
