# GoReleaser (dockers_v2) supplies the prebuilt binary under $TARGETPLATFORM.
FROM gcr.io/distroless/static-debian13:nonroot@sha256:18f4cc26c9ffa7f20a359298be7deadac5c607c8e03a02b8119f1a5fc2f82c99
ARG TARGETPLATFORM
COPY $TARGETPLATFORM/nuxd /usr/local/bin/nuxd
USER 65532:65532
WORKDIR /var/lib/nuxd
EXPOSE 8443 8444
ENTRYPOINT ["/usr/local/bin/nuxd"]
