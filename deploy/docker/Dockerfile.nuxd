# GoReleaser (dockers_v2) supplies the prebuilt binary under $TARGETPLATFORM.
FROM gcr.io/distroless/static-debian13:nonroot@sha256:25ac8f0c3b2334a9eb05452266bd4697864a8c8ef0ef71e5e6480d7f92868329
ARG TARGETPLATFORM
COPY $TARGETPLATFORM/nuxd /usr/local/bin/nuxd
USER 65532:65532
WORKDIR /var/lib/nuxd
EXPOSE 8443 8444
ENTRYPOINT ["/usr/local/bin/nuxd"]
