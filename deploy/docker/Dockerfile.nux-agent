# GoReleaser (dockers_v2) supplies the prebuilt binary under $TARGETPLATFORM.
FROM gcr.io/distroless/static-debian13:nonroot@sha256:18f4cc26c9ffa7f20a359298be7deadac5c607c8e03a02b8119f1a5fc2f82c99
ARG TARGETPLATFORM
COPY $TARGETPLATFORM/nux /usr/local/bin/nux
USER 65532:65532
ENTRYPOINT ["/usr/local/bin/nux", "agent"]
